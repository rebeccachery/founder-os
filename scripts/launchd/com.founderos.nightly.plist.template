<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Rendered by scripts/install_nightly.sh. launchd (unlike cron) runs a missed
  StartCalendarInterval job when the Mac wakes, so a closed laptop at 6:30
  still gets its scan when it's opened.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.founderos.nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/scripts/nightly.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>__HOUR__</integer>
    <key>Minute</key>
    <integer>__MINUTE__</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__ROOT__/storage/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/storage/logs/launchd.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
